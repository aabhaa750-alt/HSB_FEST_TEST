            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_name\": \"\",\n  \"roll_number\": \"2026CS109\",\n  \"email\": \"invalid-email-format\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events/1/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events", "1", "register"]
        },
        "description": "Demonstrates server-side validation error handling. Missing student_name and invalid email returns 400 Bad Request."
      },
      "response": [
        {
          "name": "400 Bad Request - Missing Required Field / Invalid Email",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"\",\n  \"roll_number\": \"2026CS109\",\n  \"email\": \"invalid-email\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            }
          },
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"detail\": \"Student name, roll number, and email must not be empty\"\n}"
        }
      ]
    },
    {
      "name": "GET /api/registrations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Registrations list includes student and event title\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    if (jsonData.length > 0) {",
              "        pm.expect(jsonData[0]).to.have.property(\"student_name\");",
              "        pm.expect(jsonData[0]).to.have.property(\"roll_number\");",
              "        pm.expect(jsonData[0]).to.have.property(\"email\");",
              "        pm.expect(jsonData[0]).to.have.property(\"event_title\");",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/registrations?event_id=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "registrations"],
          "query": [
            {
              "key": "event_id",
              "value": "1",
              "description": "Optional filter by event_id"
            }
          ]
        },
        "description": "Returns list of student registrations, including event_title for admin dashboard."
      },
      "response": []
    },
    {
      "name": "GET /api/stats",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Stats contains all overview metrics\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"total_events\");",
              "    pm.expect(jsonData).to.have.property(\"total_registrations\");",
              "    pm.expect(jsonData).to.have.property(\"total_capacity\");",
              "    pm.expect(jsonData).to.have.property(\"overall_utilization_pct\");",
              "    pm.expect(jsonData).to.have.property(\"upcoming_events_count\");",
              "    pm.expect(jsonData).to.have.property(\"events_by_category\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "stats"]
        },
        "description": "Returns live computed statistics: total_events, total_registrations, total_capacity, overall_utilization_pct, upcoming_events_count, and events_by_category."
      },
      "response": []
    },
